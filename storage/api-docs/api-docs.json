    "components": {
        "schemas": {
            "AvatarRequest": {
                "required": [
                    "avatar"
                ],
                "properties": {
                    "avatar": {
                        "type": "string",
                        "format": "binary"
                    }
                },
                "type": "object"
            },
            "FirebaseLoginRequest": {
                "required": [
                    "token"
                ],
                "properties": {
                    "token": {
                        "type": "string",
                        "example": "firebase-id-token"
                    }
                },
                "type": "object"
            },
            "LoginRequest": {
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "example": "admin@biblio.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "password"
                    }
                },
                "type": "object"
            },
            "ApiMessageResponse": {
                "properties": {
                    "message": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "AvatarResponse": {
                "properties": {
                    "avatar": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "UserCredentialsResponse": {
                "properties": {
                    "user": {
                        "properties": {
                            "id": {
                                "type": "integer",
                                "example": 1
                            },
                            "name": {
                                "type": "string",
                                "example": "user"
                            },
                            "email": {
                                "type": "string",
                                "example": "user@somewhere.com"
                            },
                            "email_verified_at": {
                                "type": "string",
                                "nullable": true
                            },
                            "created_at": {
                                "type": "string",
                                "example": "2026-05-22T02:03:07.000000Z"
                            },
