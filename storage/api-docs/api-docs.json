    "components": {
        "schemas": {
            "Book": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "8fd93ee3-3815-4334-9218-7ebc50e1343f"
                    },
                    "genre_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Judul Buku"
                    },
                    "isbn": {
                        "type": "string",
                        "example": "123ABC"
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    },
                    "author": {
                        "type": "string",
                        "example": "Seseorang"
                    },
                    "publisher": {
                        "type": "string",
                        "nullable": true
                    },
                    "lang": {
                        "type": "string",
                        "example": "id"
                    },
                    "published_date": {
                        "type": "string",
                        "nullable": true
                    },
                    "format": {
                        "type": "string",
                        "example": "pdf"
                    },
                    "page_count": {
                        "type": "integer",
                        "nullable": true
                    },
                    "price": {
                        "type": "number",
                        "example": 1234
                    },
                    "cover_url": {
                        "type": "string",
                        "nullable": true
                    },
                    "cover_sm": {
                        "type": "string",
                        "nullable": true
                    },
                    "cover_md": {
                        "type": "string",
                        "nullable": true
                    },
                    "cover_lg": {
