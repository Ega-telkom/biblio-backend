                                    "published_date": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "format": {
                                        "type": "string",
                                        "enum": [
                                            "pdf",
                                            "epub",
                                            "mobi",
                                            "djvu"
                                        ]
                                    },
                                    "page_count": {
                                        "type": "integer"
                                    },
                                    "price": {
                                        "type": "integer"
                                    },
                                    "file": {
                                        "type": "string",
                                        "format": "binary"
                                    },
                                    "cover": {
