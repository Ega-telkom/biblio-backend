FROM php:8.5-fpm-alpine

# 1. Install utility dasar yang dibutuhkan runtime aplikasi
RUN apk add --no-cache git curl unzip gnu-libiconv

# 2. Ambil script installer resmi dari repository terpercaya
COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/

# 3. Install ekstensi PHP (sama dengan prod) + xdebug untuk dev
RUN install-php-extensions \
    gd \
    pdo \
    pdo_pgsql \
    pgsql \
    intl \
    zip \
    bcmath \
    exif \
    opcache \
    redis \
    xdebug

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

# Dev: install semua dependencies (termasuk dev dependencies)
# Tidak COPY . . agar hot reload bekerja via volume mount di docker-compose
COPY composer.json composer.lock ./
RUN composer install --no-scripts --no-interaction

RUN echo "upload_max_filesize = 100M" > /usr/local/etc/php/conf.d/uploads.ini && \
    echo "post_max_size = 100M" >> /usr/local/etc/php/conf.d/uploads.ini && \
    echo "max_execution_time = 300" >> /usr/local/etc/php/conf.d/uploads.ini

EXPOSE 9000
CMD ["php-fpm"]